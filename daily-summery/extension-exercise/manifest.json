{
  "manifest_version": 3,
  "name": "English Summary Saver (Exercise)",
  "version": "0.1.0",
  "description": "A practice extension for saving English summaries.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
        {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"]
        }
    ]
}